# Example settings for the verifier. Copy to services/verifier/.env and use the same passwords as infra/.env.
# Development values only (synthetic). Never use these on a real server.

# Redis (verification job queue, Redis Streams, D23)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=cambiar-esta-clave
# Must be longer than VERIFY_BLOCK_MS, or the blocking read times out.
REDIS_SOCKET_TIMEOUT_SECONDS=10
VERIFY_REQUESTS_STREAM=verify.requests
VERIFY_RESULTS_STREAM=verify.results
VERIFY_CONSUMER_GROUP=verifier
VERIFY_CONSUMER_NAME=verifier-1
# How long one read waits for new jobs.
VERIFY_BLOCK_MS=5000
# A job delivered and not confirmed for this long is taken again (worker crashed or failed).
VERIFY_CLAIM_IDLE_MS=60000
# How long the verifier remembers a job_id it already answered (7 days).
VERIFY_PROCESSED_TTL_SECONDS=604800

# S3 storage for receipt images (SeaweedFS, D17)
S3_ENDPOINT=http://127.0.0.1:8333
S3_ACCESS_KEY=amr-dev
S3_SECRET_KEY=cambiar-esta-clave-larga
S3_BUCKET=comprobantes
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=30

# Fake OCR (step 5): recorded response with the fields already extracted. Relative to services/verifier.
OCR_FAKE_RECORDING=verifier/ocr/recordings/factura-a-sintetica.json
