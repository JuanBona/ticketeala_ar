# Example settings for apps/api. Copy to apps/api/.env; passwords must match infra/.env.
DATABASE_URL=postgresql://amr:cambiar-esta-clave@localhost:5432/amr_viajes
# Separate database for integration tests: they wipe it on every run.
TEST_DATABASE_URL=postgresql://amr:cambiar-esta-clave@localhost:5432/amr_viajes_test
PORT=3000
# Password of every synthetic employee created by `npx prisma db seed` (stored as an argon2 hash).
SEED_PASSWORD=cambiar-esta-clave
# Signs the access tokens (D12, D34). At least 32 characters; generate one with: openssl rand -base64 48
JWT_SECRET=cambiar-este-secreto-por-uno-al-azar-de-48-caracteres
# Encrypts TOTP secrets in the database (RN30, D35). 32 bytes in base64; generate with: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=cambiar-por-32-bytes-al-azar-en-base64=
