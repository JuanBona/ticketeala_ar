# Example settings for infra/docker-compose.yml. Copy to infra/.env and change the passwords.
# Development values only (synthetic). Never use these on a real server.

# PostgreSQL
POSTGRES_DB=amr_viajes
POSTGRES_USER=amr
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_PORT=5432

# Redis (verification job queue, Redis Streams)
REDIS_PASSWORD=cambiar-esta-clave
REDIS_PORT=6379

# S3 storage for receipt images (SeaweedFS, D17)
S3_ACCESS_KEY=amr-dev
S3_SECRET_KEY=cambiar-esta-clave-larga
S3_BUCKET=comprobantes
S3_PORT=8333
